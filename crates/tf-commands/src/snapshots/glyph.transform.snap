---
source: crates/tf-commands/src/registry.rs
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`glyph.transform`: apply an affine transform to a glyph layer or part of it.",
  "properties": {
    "id": {
      "description": "The glyph.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "layer": {
      "description": "The layer.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "matrix": {
      "additionalProperties": false,
      "description": "The transform.",
      "properties": {
        "dx": {
          "description": "`xOffset`, in font units.",
          "format": "double",
          "type": "number"
        },
        "dy": {
          "description": "`yOffset`, in font units.",
          "format": "double",
          "type": "number"
        },
        "xx": {
          "description": "`xScale`.",
          "format": "double",
          "type": "number"
        },
        "xy": {
          "description": "`xyScale`.",
          "format": "double",
          "type": "number"
        },
        "yx": {
          "description": "`yxScale`.",
          "format": "double",
          "type": "number"
        },
        "yy": {
          "description": "`yScale`.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "dx",
        "dy",
        "xx",
        "xy",
        "yx",
        "yy"
      ],
      "type": "object"
    },
    "selection": {
      "additionalProperties": false,
      "description": "The parts to transform; `null` transforms every point, component and anchor.",
      "properties": {
        "anchors": {
          "description": "Anchor indices.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "components": {
          "description": "Component indices.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "points": {
          "description": "Point indices into the layer's packed outline.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "anchors",
        "components",
        "points"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "layer",
    "matrix",
    "selection"
  ],
  "title": "GlyphTransform",
  "type": "object"
}
